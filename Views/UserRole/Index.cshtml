<h1>
    User Roles
</h1>


<div class="container">
    <table class="table" id="userRoles">
        <thead>
            <tr>
                <th scope="col">UserName</th>
                <th scope="col">Current Role</th>
                <th scope="col">Change Role</th>
            </tr>
        </thead>
        <tbody>
           
        </tbody>
    </table>
</div>
<div class="modal fade" id="EditRoleModel" tabindex="-1" aria-labelledby="editRoleLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editRoleLabel">Edit Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="roleList">
                <label for="roleSelect" class="form-label">Select Role</label>
                <select class="form-select" id="roleSelect">
                    <!-- options will be added dynamically -->
                </select>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="saveRoleBtn">Save changes</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/userrole.js"></script>